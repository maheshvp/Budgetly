<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Microsoft.OpenApi 2.x is vulnerable (GHSA-v5pm-xwqc-g5wc); the fix is only in the
       breaking 3.x rewrite, which is incompatible with Microsoft.AspNetCore.OpenApi 10.x.
       Suppress this specific advisory until the ASP.NET Core package ships a 3.x-compatible release. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v5pm-xwqc-g5wc" />
  </ItemGroup>
</Project>
